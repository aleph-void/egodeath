{
  "name": "egodeath",
  "version": "1.0.0",
  "description": "JavaScript obfuscator",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "obfuscate": "node dist/index.js",
    "obfuscate-package": "tsx --tsconfig tools/tsconfig.json tools/obfuscate-package.ts",
    "benchmark": "tsx --tsconfig tools/tsconfig.json tools/benchmark.ts",
    "detect-obfuscation": "tsx --tsconfig tools/tsconfig.json tools/obfuscation-detection-test.ts",
    "adversarial-test": "tsx --tsconfig tools/tsconfig.json tools/adversarial-test.ts",
    "benchmark:transforms": "npm run build && node tools/benchmark-transforms.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc --noEmit -p tools/tsconfig.json"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "estraverse": "^5.3.0",
    "is-valid-var-name": "^1.0.2",
    "jsdom": "^30.1.1",
    "recast": "^0.24.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/estraverse": "^5.1.7",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webcrack": "^2.16.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
