{
  "name": "egodeath",
  "version": "1.0.5",
  "description": "JavaScript obfuscator",
  "keywords": [
    "obfuscator",
    "obfuscation",
    "javascript",
    "minify",
    "anti-reverse-engineering"
  ],
  "homepage": "https://github.com/aleph-void/egodeath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleph-void/egodeath.git"
  },
  "bugs": {
    "url": "https://github.com/aleph-void/egodeath/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "egodeath": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/obfuscated",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "jest",
    "obfuscate": "node dist/cli.js",
    "obfuscate-package": "tsx --tsconfig tools/tsconfig.json tools/obfuscate-package.ts",
    "benchmark": "tsx --tsconfig tools/tsconfig.json tools/benchmark.ts",
    "detect-obfuscation": "tsx --tsconfig tools/tsconfig.json tools/obfuscation-detection-test.ts",
    "adversarial-test": "tsx --tsconfig tools/tsconfig.json tools/adversarial-test.ts",
    "benchmark:transforms": "npm run build && node tools/benchmark-transforms.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc --noEmit -p tools/tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "author": "nstarke",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "estraverse": "^5.3.0",
    "is-valid-var-name": "^1.0.2",
    "jsdom": "^31.0.0",
    "recast": "^0.24.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/estraverse": "^5.1.7",
    "@types/estree": "^1.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.3.1"
  }
}
